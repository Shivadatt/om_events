# Keep true for local runserver. Set false in production.
DEBUG=true
SECRET_KEY=replace-with-at-least-50-random-characters
JWT_SECRET_KEY=replace-with-a-different-50-character-secret
ALLOWED_HOSTS=events.example.com,localhost,127.0.0.1
# SQLite is used when DB_ENGINE is blank. For SQL Server use:
# DB_ENGINE=mssql
DB_ENGINE=
DB_NAME=EventPlatform
DB_USER=event_user
DB_PASSWORD=
DB_HOST=sqlserver
DB_PORT=1433
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_EXTRA_PARAMS=TrustServerCertificate=yes
BUSINESS_NAME=Om Events
BUSINESS_PHONE=919876543210
BUSINESS_EMAIL=hello@omevents.in
GST_PERCENT=18
DELIVERY_CHARGE=500
TRAVEL_CHARGE=0
MAX_CONTENT_LENGTH_MB=20
LOG_LEVEL=INFO
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
# Production example: django.core.cache.backends.redis.RedisCache
CACHE_LOCATION=om-events
